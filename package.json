{
  "name": "idealoop",
  "version": "1.0.0",
  "description": "IdeaLoop is a web-based platform for creative individuals to share and discover projects across multiple media (coding, 3D modeling, digital art, writing, music, crafts), request skill mentorship, and find project collaborators.",
  "main": "dist/server.js",
  "scripts": {
    "test": "tsx --test src/tests/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diuazaza/IdeaLoop.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/diuazaza/IdeaLoop/issues"
  },
  "homepage": "https://github.com/diuazaza/IdeaLoop#readme",
  "dependencies": {
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.6",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22"
  }
}
