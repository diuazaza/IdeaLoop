# Server Config
PORT=5000
NODE_ENV=development

# Database Config (PostgreSQL / Render / Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/idealoop_db

# JWT signing secret (required for the API; at least 32 random characters)
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# AWS S3 / Object Storage (Media Uploads)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=idealoop-media-uploads